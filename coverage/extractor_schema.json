{
  "extraction_level": "lexical (regular expressions over source text); no parser or compiler is used, so construct counts are approximations of AST-level counts",
  "decorators_pattern": "@[A-Z][A-Za-z0-9]*",
  "lifecycle_handlers": [
    "aboutToAppear",
    "aboutToDisappear",
    "onPageShow",
    "onPageHide",
    "onBackPress",
    "onDidBuild",
    "aboutToReuse",
    "aboutToRecycle",
    "onWillApplyTheme"
  ],
  "arkui_components": [
    "Column",
    "Row",
    "Stack",
    "Flex",
    "RelativeContainer",
    "GridRow",
    "GridCol",
    "Text",
    "Button",
    "Image",
    "TextInput",
    "TextArea",
    "Search",
    "Toggle",
    "Checkbox",
    "CheckboxGroup",
    "Radio",
    "Slider",
    "Progress",
    "LoadingProgress",
    "Rating",
    "Select",
    "DatePicker",
    "TimePicker",
    "TextPicker",
    "Divider",
    "Blank",
    "Span",
    "ImageSpan",
    "RichText",
    "List",
    "ListItem",
    "ListItemGroup",
    "Grid",
    "GridItem",
    "Scroll",
    "Swiper",
    "Tabs",
    "TabContent",
    "Navigation",
    "NavDestination",
    "NavRouter",
    "Navigator",
    "Refresh",
    "WaterFlow",
    "FlowItem",
    "Panel",
    "SideBarContainer",
    "Badge",
    "Counter",
    "Marquee",
    "QRCode",
    "Web",
    "Video",
    "XComponent",
    "Canvas",
    "Circle",
    "Rect",
    "Line",
    "Path",
    "Polygon",
    "Polyline",
    "Ellipse",
    "Shape",
    "Gauge",
    "DataPanel",
    "Menu",
    "MenuItem",
    "Stepper",
    "StepperItem",
    "AlphabetIndexer",
    "PatternLock",
    "Hyperlink",
    "SymbolGlyph",
    "ForEach",
    "LazyForEach",
    "Repeat"
  ],
  "import_pattern": "import ... from '<module>' | import '<module>'",
  "control_flow_and_typing": {
    "if_statement": "\\bif\\s*\\(",
    "else_clause": "\\belse\\b",
    "for_loop": "\\bfor\\s*\\(",
    "while_loop": "\\bwhile\\s*\\(",
    "switch_statement": "\\bswitch\\s*\\(",
    "ternary_operator": "\\?[^.?:]+:",
    "try_catch": "\\btry\\s*\\{",
    "async_function": "\\basync\\b",
    "await_expression": "\\bawait\\b",
    "promise_usage": "\\bPromise\\b",
    "arrow_function": "=>",
    "class_declaration": "\\bclass\\s+[A-Za-z_]\\w*",
    "interface_declaration": "\\binterface\\s+[A-Za-z_]\\w*",
    "enum_declaration": "\\benum\\s+[A-Za-z_]\\w*",
    "type_alias": "\\btype\\s+[A-Za-z_]\\w*\\s*=",
    "generic_type_argument": "\\b(?:Array|Map|Set|Promise|Record|Partial|Readonly)<",
    "type_annotation": "[A-Za-z_]\\w*\\s*:\\s*(?:string|number|boolean|void|any|[A-Z]\\w*)(?:\\[\\])?\\b",
    "null_safety_operator": "\\?\\.|\\?\\?",
    "spread_operator": "\\.\\.\\.",
    "template_literal": "`[^`]*\\$\\{"
  },
  "ui_patterns": {
    "list_view": "\\b(?:List|LazyForEach)\\s*\\(",
    "list_detail_or_navigation": "\\b(?:router\\.(?:pushUrl|push|back|replaceUrl)|Navigation|NavDestination|NavPathStack|Navigator)\\b",
    "tabbed_interface": "\\bTabs\\s*\\(",
    "swiper_carousel": "\\bSwiper\\s*\\(",
    "grid_layout": "\\bGrid\\s*\\(",
    "scrollable_content": "\\bScroll\\s*\\(",
    "form_input": "\\b(?:TextInput|TextArea|Search|Checkbox|Radio|Toggle|Slider|Select|DatePicker|TimePicker)\\s*\\(",
    "dialog_or_toast": "\\b(?:promptAction\\.\\w+|AlertDialog|CustomDialogController|@CustomDialog)\\b",
    "local_component_state": "@State\\b",
    "parent_child_state_sharing": "@(?:Prop|Link|Provide|Consume|ObjectLink)\\b",
    "app_or_persistent_storage": "\\b(?:AppStorage|LocalStorage|PersistentStorage|@StorageLink|@StorageProp|@LocalStorageLink|@LocalStorageProp|@PersistStorageProp)\\b",
    "animation": "\\b(?:animateTo|animation\\s*\\(|\\.transition\\s*\\(|animator)\\b",
    "gesture_handling": "\\b(?:TapGesture|LongPressGesture|PanGesture|PinchGesture|RotationGesture|SwipeGesture|GestureGroup)\\b",
    "resource_reference": "\\$r\\s*\\(",
    "conditional_rendering": "\\bif\\s*\\([^)]*\\)\\s*\\{[^}]*\\b(?:Text|Column|Row|Image|Button)\\s*\\(",
    "reusable_builder": "@Builder\\b"
  },
  "size_complexity": {
    "methods": "named function/method headers followed by '{', excluding control keywords",
    "arrow_functions": "count of '=>'",
    "comment_lines": "lines starting with // plus /* */ blocks",
    "max_brace_nesting": "maximum depth of '{' nesting after comment removal",
    "custom_component_instantiations": "calls of struct names defined in the same sample"
  },
  "deduplication": "exact: SHA-256 of raw and of comment/whitespace-normalized final_code; near-duplicate: Jaccard similarity of 5-token shingle sets over normalized code, all pairs",
  "columns_in_every_table": [
    "total_occurrences",
    "samples_with_at_least_one",
    "share_of_samples_pct",
    "samples_with_at_least_one_compiled_only"
  ]
}